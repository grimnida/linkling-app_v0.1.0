{
  "name": "linkling-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linkling 학생용 웹/PWA (저장소 A) — 원격 단어팩 로더 + 공통 학습 엔진",
  "scripts": {
